{
  "name": "viva-mode",
  "version": "1.0.0",
  "private": true,
  "description": "A VTU lab-viva simulator whose exam room softens as your breathing settles. Built with the Presage SmartSpectra SDK.",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "verify": "npm run typecheck && npm test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "presage",
    "smartspectra",
    "viva",
    "electron",
    "rppg"
  ],
  "license": "MIT",
  "dependencies": {
    "@smartspectra/node-sdk": "3.4.0",
    "chart.js": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.vivamode.app",
    "productName": "Viva Mode",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "koffi@2.16.3": true,
    "protobufjs@7.6.6": true,
    "electron-winstaller@5.4.0": true
  }
}
